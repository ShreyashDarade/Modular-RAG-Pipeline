# ============================================
# RAG-OCR Pipeline - environment configuration
# ============================================
# Copy to .env and fill in. Every value below is optional unless marked REQUIRED.
# Models and collections can also be declared in a TOML file (RAG_CONFIG) - see config/rag.example.toml.

# =========================
# Application
# =========================
APP_NAME=OCR-rag
ENVIRONMENT=production
DATA_DIR=./data
LOG_LEVEL=INFO
LOG_FORMAT=text                 # text | json (use json in containers)
# RAG_CONFIG=config/rag.toml    # declare several chat/embedding models and collections
# PLUGINS=["my_company.rag_plugin"]   # modules exposing register(registries): extra parsers, providers, ...

# =========================
# Elasticsearch (REQUIRED: one of the two)
# =========================
# Elastic Cloud:
ES_CLOUD_ID=your-deployment:base64encodedstring...
ES_API_KEY=your-api-key-here
# Self-hosted (comma separated for several nodes), with an API key or basic auth:
# ES_HOST=https://es1:9200,https://es2:9200
# ES_USERNAME=elastic
# ES_PASSWORD=...
# ES_VERIFY_CERTS=true
# ES_CA_CERTS=/path/to/ca.pem

# Index names of the "default" collection (when RAG_CONFIG is not used)
ES_INDEX_TEXT=doc-text
ES_INDEX_TABLES=doc-tables
ES_INDEX_IMAGES=doc-images
ES_INDEX_REGISTRY=doc-registry   # ingestion ledger: which files are fully indexed

# Index layout / vector storage
ES_AUTO_CREATE_INDICES=true      # false = a missing index is an error
ES_NUMBER_OF_SHARDS=1
ES_NUMBER_OF_REPLICAS=1
ES_REFRESH_INTERVAL=5s
ES_VECTOR_INDEX_TYPE=int8_hnsw   # bbq_hnsw (ES 8.18+/9.x) is ~32x smaller; auto = server default

# Connection pool and bulk indexing
ES_CONNECTIONS_PER_NODE=32
ES_MAX_CONCURRENCY=64
ES_BULK_CHUNK_SIZE=500

# =========================
# Model providers (credentials; models themselves are in RAG_CONFIG)
# =========================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # REQUIRED for the default OpenAI models
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1024   # text-embedding-3-*: shortened vectors, less memory
# OPENAI_BASE_URL=https://my-gateway/v1      # OpenAI-compatible server (vLLM, LiteLLM, ...)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# ANTHROPIC_API_KEY=            # pip install 'turinton-rag[anthropic]'
# GOOGLE_API_KEY=               # pip install 'turinton-rag[google]'
# OLLAMA_BASE_URL=http://localhost:11434   # pip install 'turinton-rag[ollama]'
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=4
MODEL_MAX_CONCURRENCY=32         # in-flight calls per provider client; excess callers queue
EMBEDDING_BATCH_SIZE=256
EMBEDDING_CACHE_ENTRIES=10000

# =========================
# Chunking (default collection)
# =========================
CHUNK_SIZE=800
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
KEYWORD_TOP_K=20

# =========================
# Retrieval
# =========================
RETRIEVER_TOP_K=10
HYBRID_ALPHA=0.5                 # 1.0 = lexical only, 0.0 = vector only
RERANK_ENABLED=true
RERANK_TOP_K=6
QUERY_EXPANSION_ENABLED=true     # false removes an LLM call from every search
QUERY_EXPANSION_TIMEOUT_SECONDS=5
ENABLE_CROSS_REFERENCES=true
PAGE_CONTEXT_WINDOW=1

# =========================
# Chat
# =========================
CHAT_STORE=memory                # memory | redis (use redis with more than one replica)
CHAT_HISTORY_MESSAGES=20
CHAT_HISTORY_TTL_SECONDS=86400
CHAT_CONDENSE_QUESTIONS=true

# =========================
# Ingestion
# =========================
MAX_UPLOAD_MB=100
INGEST_BACKEND=inprocess         # inprocess | redis (redis: separate scalable workers)
INGEST_CONCURRENCY=2             # concurrent jobs per worker process
INGEST_EMBEDDED_WORKER=true      # false on API replicas when workers run separately
INGEST_QUEUE_MAX_SIZE=1000
INGEST_WAIT_DEFAULT=true         # POST /ingest waits for the result (false: returns 202 immediately)
INGEST_MAX_ATTEMPTS=3
INGEST_REFRESH=each              # each: searchable the moment a job succeeds | interval: searchable within ES_REFRESH_INTERVAL (+1s; searches in that window are not cached)
JOB_VISIBILITY_TIMEOUT_SECONDS=300
WATCH_DATA_DIR=false             # ingest files dropped into DATA_DIR (run on ONE process only)
PDF_EXTRACT_TABLES=true

# =========================
# OCR (worker side)
# =========================
OCR_ENABLED=true
OCR_GPU_ENABLED=true
OCR_MODEL_DIR=./models
OCR_DOWNLOAD_MODELS=true         # false once the weights are baked into the image
OCR_BATCH_SIZE=5
OCR_CONCURRENCY=1
OCR_MIN_IMAGE_SIDE=64            # smaller embedded images (icons, bullets) are not OCR'd
OCR_EARLY_EXIT_CONFIDENCE=0.85   # skip the slow second pass when the first already reads this well (English)
OCR_EARLY_EXIT_CONFIDENCE_DEVANAGARI=0.0   # Hindi/Marathi: its confidence is poorly calibrated; 0 = accept the first pass
# Supported: en (English), mr (Marathi), hi (Hindi)

# =========================
# API server
# =========================
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1                # processes per container; scale with replicas, and use the redis backends if > 1
RATE_LIMIT_PER_MINUTE=100        # 0 disables
RATE_LIMIT_BACKEND=memory        # memory | redis (redis: one limit shared by all replicas)
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_REQUESTS=1024     # above this, new requests get 503 + Retry-After (0 disables)
CORS_ORIGINS=["*"]
METRICS_ENABLED=true
MCP_ENABLED=false                # serve the MCP endpoint at MCP_PATH (default /mcp)
# MCP_ALLOWED_HOSTS=["rag.example.com"]   # required when served under a real domain

# =========================
# Redis (cache, rate limits, chat history, job queue)
# =========================
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=rag              # key prefix; lets environments share one Redis
CACHE_BACKEND=memory             # memory | redis | tiered
CACHE_TTL_SECONDS=3600
